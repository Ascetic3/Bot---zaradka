BOT_TOKEN=вставьте_сюда_токен_бота
# Необязательный стабильный ключ для подписи подтверждений регистрации.
# Если оставить пустым, используется BOT_TOKEN. Не публикуйте настоящее значение.
PHONE_PROOF_SECRET=
PRIVACY_POLICY_URL=
# Утверждённый владельцем идентификатор версии политики; оставьте пустым до утверждения.
PRIVACY_POLICY_VERSION=
# true только после заполнения, проверки и публичной публикации политики.
PRIVACY_POLICY_PUBLISHED=

# Отдельная публичная HTTPS-ссылка для демонстрационного экрана; не является действующей политикой.
PREVIEW_POLICY_URL=

# Telegram ID владельца клуба (числа). Оставьте пустым, пока владелец не выбран.
OWNER_TELEGRAM_ID=

# Папка копий; пустое значение использует приватную системную папку пользователя.
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
BACKUP_AUTO_ENABLED=true

# Необязательные лимиты запросов. Пустое значение оставляет безопасное значение по умолчанию.
BOT_LIMIT_START_PER_MINUTE=
BOT_LIMIT_MYID_PER_MINUTE=
BOT_LIMIT_ADMIN_COMMAND_PER_MINUTE=
BOT_LIMIT_REGISTRATION_START_PER_5_MINUTES=
BOT_LIMIT_REGISTRATION_ANSWERS_PER_MINUTE=
BOT_LIMIT_REGISTRATION_SAVE_PER_5_MINUTES=
BOT_LIMIT_ADMIN_SEARCH_PER_MINUTE=
BOT_LIMIT_ADMIN_PAGES_PER_MINUTE=
BOT_LIMIT_STATISTICS_PER_MINUTE=
BOT_LIMIT_EXCEL_PER_5_MINUTES=
BOT_LIMIT_EXCEL_CONFIRM_PER_5_MINUTES=
BOT_LIMIT_PREVIEW_PER_5_MINUTES=
BOT_LIMIT_PREVIEW_ANSWERS_PER_MINUTE=
BOT_LIMIT_PROFILE_EDIT_PER_MINUTE=
BOT_LIMIT_PARTICIPANT_DATA_PER_5_MINUTES=

